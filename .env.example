OCR_PROVIDER=paddleocr
FIGURELEARNING_DB_BACKEND=sqlite
FIGURELEARNING_MYSQL_DSN=mysql+pymysql://figurelearning:password@127.0.0.1:3306/figurelearning?charset=utf8mb4
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
PADDLE_PDX_MODEL_SOURCE=bos
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=False
OCR_MODEL_SIZE=mobile
OCR_MAX_SIDE=1800
OCR_CPU_THREADS=4
OCR_OMP_THREADS=1
OCR_RECOGNITION_BATCH_SIZE=4
